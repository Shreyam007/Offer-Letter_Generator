# Backend environment configuration example
# Copy this file to backend/.env when running locally.

MONGO_URI=mongodb://localhost:27017/offerflow
PORT=5000

# SMTP / email settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=hr@yourdomain.com
